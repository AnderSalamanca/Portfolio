---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths(){
    const projects = await getCollection('projects');
    const publishedProjects = projects.filter(project => !project.data.draft);
    return publishedProjects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

// 2. The Worker: Grabs the data for THIS specific page
const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={project.data.title}>
    <main class="container mx-auto px-4 py-10 max-w-3xl">
        <!-- Add a "Back" link here -->
        <a href="/" class="text-blue-600 hover:underline mb-8 inline-block">&larr; Back to Portfolio</a>
        
        <div class="overflow-hidden">
		
		<Image
			src={project.data.coverImage}
			alt={`Cover image for ${project.data.title}`}
			width={800}
			height={500}
			quality={80}
			format="webp"
			class="w-full h-64 object-cover mb-4"
			transition:name={`image-${project.id}`}
			/>
	</div>

        <h1 transition:name={`title-${project.id}`} class="text-4xl font-bold mb-4">{project.data.title}</h1>
        
        <!-- This is a special Astro component that renders your MDX styling -->
        <div class="prose prose-lg max-w-none">
            <Content />
        </div>
    </main>
</Layout>