---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
	title: string;
    description: string;
    tags: string[];
	id: string;
    coverImage?: ImageMetadata;
}

const { title, description, tags, id, coverImage } = Astro.props;
---

<a href={`/projects/${id}`} class="block">
<article class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 hover:shadow-xl transition-shadow duration-300">
	
	<div class="overflow-hidden">
		
		<Image
			src={coverImage}
			alt={`Cover image for ${title}`}
			width={600}
			height={300}
			quality={80}
			format="webp"
			class="w-full h-48 object-cover transform group-hover:scale-105 transition-transform duration-300"
			transition:name={`image-${id}`}
			/>
	</div>

	<div class="p-6">
	<!-- Title: Make it bold and slightly larger (text-xl) -->
	<h3 transition:name={`title-${id}`} class="text-2xl font-bold text-gray-900 mb-2">
		{title}
	</h3>

	<!-- Description: Use a gray text color so it stands out less than the title -->
	<p class="text-gray-600 mb-4 leading-relaxed">
		{description}
	</p>

	<!-- Tags Container: Use Flexbox to align them in a row, with a small gap -->
	<div class="flex-wrap gap-2 flex">
		{tags.map((tag) => (
			/* 
			   Tag Item: 
			   - Small text (text-xs or text-sm)
			   - Background color (e.g., bg-blue-100)
			   - Text color (e.g., text-blue-800)
			   - Rounded pill shape (rounded-full)
			   - Padding (px-2 py-1)
			*/
			<span class="text-xs font-medium bg-blue-100 text-blue-800 rounded-full px-3 py-1">
				{tag}
			</span>
		))}
	</div>
	</div>
</article>
</a>